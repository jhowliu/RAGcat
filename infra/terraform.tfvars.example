cognito_pool_id = "ap-southeast-2_EXISTING_POOL_ID"
files_bucket    = "YOUR_PREFIX-files"
web_bucket      = "YOUR_PREFIX-web"
# name_prefix   = "ragcat"
# tags          = { owner = "you@example.com" }

# Restricted shared account: when the account forbids creating VPCs, security groups or IAM roles, reuse
# existing ones (see README "Restricted shared account").
# existing_network = {
#   vpc_id             = "vpc-..."
#   public_subnet_ids  = ["subnet-...", "subnet-..."]
#   private_subnet_ids = ["subnet-...", "subnet-..."]
# }
# shared_account = {
#   alb_security_group_ids     = ["sg-...", "sg-..."] # must allow 443 in
#   runtime_security_group_ids = ["sg-..."]
#   cache_security_group_ids   = ["sg-..."]
#   ecs_execution_role_arn     = "arn:aws:iam::ACCOUNT_ID:role/ECS_EXECUTION_ROLE"
#   ecs_task_role_arn          = "arn:aws:iam::ACCOUNT_ID:role/ECS_TASK_ROLE"
#   lambda_role_arn            = "arn:aws:iam::ACCOUNT_ID:role/LAMBDA_ROLE"
#   site_domain                = "ragcat.example.com"
#   origin_domain              = "ragcat-api.example.com"
# }

# Optional: an existing ECS cluster.
# existing_cluster_arn = "arn:aws:ecs:ap-southeast-2:ACCOUNT_ID:cluster/EXISTING_CLUSTER"

deploy_workloads = false
# After publishing both immutable ECR tags, set deploy_workloads = true and image_tag below.
image_tag = "unpublished"
