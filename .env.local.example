# Copy to .env.local and fill these server-side keys locally. Never put them in VITE_* vars.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# make backend selects this preset. Each model provider can also be set independently.
RAGCAT_MODELS=local
RAGCAT_LLM_PROVIDER=claude
RAGCAT_EMBED_PROVIDER=openai
RAGCAT_VISION_PROVIDER=fake
RAGCAT_LLM_MODEL_ID=claude-haiku-5-5
RAGCAT_EMBED_MODEL_ID=text-embedding-3-small
RAGCAT_EMBED_DIMS=1536
RAGCAT_CONTEXTUAL=on
